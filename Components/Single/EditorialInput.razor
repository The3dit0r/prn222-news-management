@rendermode InteractiveServer

<div class="d-flex justify-content-between font-monospace px-2 py-1 z-4"
     style="font-size: 0.8em; background: #fafafa; border-radius: 0.25rem; position: sticky; top: 30px;">
    <div style="text-transform: uppercase">@ClassName</div>
    <div>│ @BindValue.Length letters</div>
</div>

<textarea @bind="@BindValue"
          @oninput="HandleInput"
          class="@GetClassName()"
          @attributes="AdditionalAttributes" />


@code {
    [Parameter, EditorRequired]
    public string BindValue { get; set; } = null!;

    [Parameter]
    public string ClassName { get; set; } = "body";

    [Parameter]
    public EventCallback<string> BindValueChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private string GetClassName()
    {
        return "editorial-input " + ClassName;
    }

    private async Task HandleInput(ChangeEventArgs e)
    {

        // Notify parent component
        await BindValueChanged.InvokeAsync(BindValue);
    }
}