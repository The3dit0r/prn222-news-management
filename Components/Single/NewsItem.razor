@using NewsManagement.Models;

@if (Article != null)
{
    
<a class="news-card" href="/article/@Article.NewsArticleId">
    <div class="news-card__cover dft-bg-cover">
        
    </div>

    <div class="news-card__content" >
        <div class="news-card__meta">
            @if (Article.CreatedDate != null) {
                <span>@Article.CreatedDate</span>
            }
            <span class="news-card__separator"> • </span>
            <span>@Article.CreatedByID</span>
            <span class="news-card__separator"> • </span>
            <span>6 minutes</span>
        </div>

        <div class="flex-1"></div>

        <h3 class="news-card__title">@Article.NewsTitle</h3>
        <p class="news-card__brief line-clamp-2">@Article.NewsContent</p>
    </div>
</a>

}

@code {
    [Parameter, EditorRequired]
    public NewsArticle Article { get; set; } = null!;
}
