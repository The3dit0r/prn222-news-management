@using NewsManagement.Models;

<div class="featured-news-card dft-bg-cover" style="background-size: 130px, auto;">
    <div class="featured-news-card__overlay">
        <div class="featured-news-card__content">
            <div class="featured-news-card__meta">
                6 minutes
            </div>

            <h2 class="featured-news-card__title">@Article.NewsTitle</h2>
            <p class="featured-news-card__brief line-clamp-2">@Article.NewsContent</p>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public NewsArticle Article { get; set; } = null!;
}