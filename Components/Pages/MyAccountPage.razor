@page "/my-account"

@using NewsManagement.Components.Single;

<div class="read-content">
    <h3 class="mb-4">My Account</h3>

    <div class="p-4 rounded-3 d-flex aictr spbtw" style="border: 2px solid #0002; border-left: 10px solid #000;">
        <div>
            <div>Administrator</div>
            <h4>Nguyen Binh Minh</h4>
        </div>

        <button class="btn">Logout</button>
    </div>

    <div style="margin-top: 4rem">
        <h4>Preference</h4>


        <div class="text-center d-flex aictr jcctr flex-column mb-4">
            <i class="end-of-list">This section is not available</i>
        </div>
    </div>

    <div class="py-4">
        <h4>Account Settings</h4>

        <div class="py-4 d-flex aictr spbtw" style="padding-left: 2rem;">
            <div>
                <h5>Full name</h5>
                <div>Your display name</div>
            </div>
            <input value="@Name" class="input" style="width: 50%; max-width: 400px" readonly/>
        </div>

        <div class="py-4 d-flex aictr spbtw" style="padding-left: 2rem;">
            <div>
                <h5>Email</h5>
                <div>Your registered email address</div>
            </div>
            <input value="@Email" class="input" style="width: 50%; max-width: 400px" readonly/>
        </div>

        <div class="py-4 d-flex aictr spbtw" style="padding-left: 2rem;">
            <div>
                <h5>Password</h5>
            </div>
            <button class="btn">Change Password</button>
        </div>
    </div>
</div>

@code {
    private string Name { get; set; } = "Nguyễn Bình Minh";
    private string Email { get; set; } = "minhbn@gmail.com";
}
