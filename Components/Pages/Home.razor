@page "/"
@page "/article"

@using NewsManagement.Models
@using NewsManagement.Components.Single
@using NewsManagement.TestData;

@using Newtonsoft.Json;

<PageTitle>Home</PageTitle>

<div style="flex: 1;" class="space-y-2 read-content">

    <h3 class="section-title">Featured News</h3>
    <FeaturedNewsItem Article="@articles[0]"/>
   
    <h3 class="section-title">Latest News</h3> 
    @foreach (var article in articles) {
        <NewsItem Article="@article"/>
    }
</div>


@code {
    private List<NewsArticle> articles = new();

    protected override void OnInitialized()
    {
        var Data = TestData.GetAllNews();
        if (Data != null)
        {
            articles = Data;
        }
    }
}