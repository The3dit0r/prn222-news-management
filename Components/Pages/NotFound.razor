@page "/not-found"

@layout MainLayout
@inject NavigationManager Navigation

<div class="read-content d-flex flex-column" style="height: 60vh; overflow: hidden;">
    <div class="user-select-none">@GetX()</div>
    <div style="flex: 1"></div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 style="font-size: 100px;">404</h1>
            <h3>Not Found</h3>
            <p>Sorry, the content you are looking for does not exist.</p>
        </div>

        <div class="d-flex gap-3 flex-column" style="margin-right: 5%">
            <button class="btn" onclick="window.history.back()">Go back</button>
            <button class="btn" onclick="window.location.pathname = ''">Home page</button>
        </div>
    </div>

    <div style="flex: 1"></div>
    <div class="user-select-none">@GetX()</div>
</div>

@code {
    private string GetX()
    {
        return "".PadLeft(200, 'X');
    }
}